# Образец .env: скопируйте (cp .env.example .env) и подставьте свои значения.
# Реальные токены и пароли храните только в .env — он в .gitignore.

# ---------- Бот ----------
# Токен от @BotFather
TG_TOKEN=
# Ваш chat id в Telegram (узнать у @userinfobot) — сюда приходят заявки и предупреждения
ADMIN_ID=
# Ключ из Anthropic Console (console.anthropic.com)
ANTHROPIC_API_KEY=

# ---------- Админка ----------
ADMIN_USERNAME=admin
# Не короче 8 символов
ADMIN_PASSWORD=
# Случайная строка от 32 символов:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=
# true, если админка открыта по HTTPS через reverse proxy (на демо-сервере с Caddy — true)
ADMIN_HTTPS_ONLY=false

# ---------- Демо-сервер (docker compose --profile https) ----------
# Домен, направленный A-записью на сервер; Caddy получит для него сертификат Let's Encrypt
# DOMAIN=demo.example.com

# ---------- Необязательные ----------
# DB_PATH=storage/bot.db
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8000
