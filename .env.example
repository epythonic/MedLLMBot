# Sample .env: copy it (cp .env.example .env) and fill in your values.
# Keep real tokens and passwords only in .env, which is in .gitignore.

# ---------- Bot ----------
# Token from @BotFather
TG_TOKEN=
# Your Telegram chat id (ask @userinfobot): leads and alerts arrive here. A personal id, not a group:
# you also reply to clients from here as the live operator
ADMIN_ID=
# Key from the Anthropic Console (console.anthropic.com)
ANTHROPIC_API_KEY=

# ---------- Admin ----------
ADMIN_USERNAME=admin
# At least 8 characters
ADMIN_PASSWORD=
# A random string of 32+ characters:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=
# true if the admin is served over HTTPS via a reverse proxy (true on the demo server with Caddy)
ADMIN_HTTPS_ONLY=false
# true only on a demo server: the «Demo data» page refreshes the demo or switches clinic/shop from the admin.
# A reset deletes all clients and leads, so a real business keeps it false
ADMIN_DEMO_TOOLS=false

# ---------- Demo server: how the admin panel is published ----------
# Docker Compose profile: tunnel (Cloudflare Tunnel) or https (Caddy on ports 80 and 443).
# Empty: only the bot and the admin on 127.0.0.1:8000, as for local development
# COMPOSE_PROFILES=tunnel
# tunnel: the token from Cloudflare (Networking → Tunnels → your tunnel); route Service URL: http://admin:8000
# TUNNEL_TOKEN=
# https: domain pointed at the server with an A record; Caddy will obtain a Let's Encrypt certificate for it
# DOMAIN=demo.example.com

# ---------- Optional ----------
# DB_PATH=storage/bot.db
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8000
