#: medllmbot/admin/templates/sqladmin/index.html:9
msgid "How the bot works"
msgstr "Как работает бот"

#: medllmbot/admin/templates/sqladmin/index.html:16
#, python-format
msgid "<b>A client writes to the bot</b> in Telegram and appears in %(clients)s."
msgstr "<b>Клиент пишет боту</b> в Telegram и появляется в %(clients)s."

#: medllmbot/admin/templates/sqladmin/index.html:19
msgid "<b>Checks before Claude:</b> whether the client is blocked, writes too often or sends a message that is too long, and whether the message shows attack signs."
msgstr "<b>Проверки до Claude:</b> заблокирован ли клиент, не пишет ли слишком часто, не слишком ли длинное сообщение, нет ли признаков атаки."

#: medllmbot/admin/templates/sqladmin/index.html:23
#, python-format
msgid "<b>Claude answers</b> from the knowledge base — %(catalog)s, %(faq)s, %(about)s — and from the latest messages in %(history)s."
msgstr "<b>Claude отвечает</b> по базе знаний — %(catalog)s, %(faq)s, %(about)s — и по последним сообщениям из %(history)s."

#: medllmbot/admin/templates/sqladmin/index.html:28
msgid "<b>Answer check:</b> made-up prices and fragments of the bot's rules never reach the client."
msgstr "<b>Проверка ответа:</b> выдуманные цены и фрагменты правил бота клиенту не уходят."

#: medllmbot/admin/templates/sqladmin/index.html:31
#, python-format
msgid "<b>Accounting:</b> every message goes to %(log)s, and its cost to %(costs)s."
msgstr "<b>Учёт:</b> каждое сообщение попадает в %(log)s, стоимость — в %(costs)s."

#: medllmbot/admin/templates/sqladmin/index.html:34
#, python-format
msgid "<b>A phone number in a message</b> is a lead: it appears in %(leads)s, and the administrator gets a notification in Telegram."
msgstr "<b>Телефон в сообщении</b> — это заявка: она появляется в %(leads)s, а администратор получает уведомление в Telegram."

#: medllmbot/admin/templates/sqladmin/index.html:38
#, python-format
msgid "<b>Live operator:</b> when a client asks for a person, you get a notification in Telegram and reply right from there, while the bot stays silent in that chat. Who is with the operator now is shown in %(clients)s."
msgstr "<b>Живой оператор:</b> клиент просит человека — вы получаете уведомление в Telegram и отвечаете ему прямо оттуда, а бот в этом чате молчит. Кто сейчас с оператором — в %(clients)s."

#: medllmbot/admin/templates/sqladmin/index.html:43
#, python-format
msgid "<b>Analytics:</b> what clients ask about, how many dialogs end with a lead and which questions the bot found no answer to — in %(analytics)s."
msgstr "<b>Аналитика:</b> о чём спрашивают клиенты, сколько диалогов заканчиваются заявкой и на какие вопросы бот не нашёл ответа — в %(analytics)s."

#: medllmbot/admin/templates/sqladmin/index.html:49
#, python-format
msgid "Each section has a %(icon)s icon next to its title: hover over it for a short hint, click it for detailed help on the side."
msgstr "У каждого раздела рядом с заголовком есть значок %(icon)s: наведите — короткая подсказка, нажмите — подробная справка сбоку."

#: medllmbot/admin/templates/sqladmin/index.html:52
msgid "Fields and columns have the same icons."
msgstr "Такие же значки стоят у полей и колонок."

#: medllmbot/admin/templates/sqladmin/index.html:53
msgid "The F1 or “?” key opens the section's help."
msgstr "Клавиши F1 или «?» открывают справку раздела."

